# Copia este archivo a .env y ajusta los valores.
# En Dokploy, estas mismas variables se configuran en el panel del servicio
# (no se necesita el archivo .env dentro del contenedor).

PORT=3000
NODE_ENV=production
DB_PATH=./data/manicura.db

# Credenciales de la única cuenta admin. Se usan SOLO la primera vez que
# arranca el servidor (o corres `npm run seed`) para crear la cuenta;
# cambios posteriores a estas variables no afectan una cuenta ya creada.
ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

# Nombre de la cookie de sesión del panel admin (opcional).
SESSION_COOKIE_NAME=sid

# Orígenes permitidos por CORS, separados por coma (sin slash final).
# Es el dominio del FRONTEND (quien hace las llamadas), no el de este
# backend — no cambia aunque cambie el dominio donde vive la API.
ALLOWED_ORIGINS=https://manicura.ankode.cloud

# Dominio de la cookie de sesión, para compartirla entre el subdominio del
# frontend y el del backend (p.ej. ".ankode.cloud" cubre tanto
# manicura.ankode.cloud como backen_general.ankode.cloud). Déjalo vacío
# para probar en localhost.
COOKIE_DOMAIN=.ankode.cloud

# 'lax' basta si frontend y backend comparten dominio raíz (caso de arriba).
# Si terminan en dominios totalmente distintos, usa 'none' (obliga a correr
# ambos servicios por HTTPS).
COOKIE_SAMESITE=lax
